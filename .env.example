# Copy to .env.local for local development. Every var below is read via
# lib/*.ts's "degrade gracefully when unset" convention — the app runs
# (mocked/limited) without any of these, EXCEPT the two marked FAIL OPEN,
# which must be set in production before launch, not just locally.

# --- Database (Supabase/Postgres) ---
# Either name works — lib/db.ts checks DATABASE_URL first, then POSTGRES_URL.
DATABASE_URL=

# --- Auth.js (lib/auth.ts) ---
# Required for real sessions to work at all (JWT signing key). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Sign in with Apple — optional; the Apple provider is only registered when
# all four of these are set, so email+password auth keeps working without them.
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# --- Transactional email (lib/email.ts, password reset only) ---
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# --- AI (lib/gemini.ts) ---
# Every trainer and AI Tutor route returns mocked responses when this is unset.
GEMINI_API_KEY=

# --- Subscriptions (RevenueCat) ---
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
# FAIL OPEN if unset: app/api/webhooks/revenuecat/route.ts no-ops (accepts
# and ignores every webhook) rather than rejecting, so entitlement writes
# silently never happen — set this before relying on real subscriptions.
REVENUECAT_WEBHOOK_SECRET=

# --- Cron routes (app/api/*/refresh) ---
# FAIL OPEN if unset: app/api/comprehension/news/refresh and
# app/api/tutor/news/refresh become fully public, unauthenticated endpoints
# that trigger paid Gemini calls — confirm this is actually set in Vercel's
# production project before launch, not just assumed from this file.
CRON_SECRET=

# --- Admin content-review tooling (app/tutor-review) — optional, dev-only ---
ANTHROPIC_API_KEY=
ANTHROPIC_REVIEW_MODEL=
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=
GEMINI_REVIEW_MODEL=
REVIEW_DAILY_CATEGORY_LIMIT=
